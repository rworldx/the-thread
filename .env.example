# Copy to .env.local (git-ignored) and fill in.
#
# TMDB API Read Access Token — the v4 BEARER token, not the v3 API key.
#   https://www.themoviedb.org/settings/api
#
# Used only by `npm run sync:tmdb`, which runs on your machine and commits its
# output. It is never read at request time and must never become a
# NEXT_PUBLIC_ variable — that would ship it to every browser.
#
# Because sync output is committed, Vercel does NOT need this variable set.
TMDB_READ_TOKEN=

# OMDb, for the Rotten Tomatoes and Metacritic scores. Free tier, 1,000/day.
#   https://www.omdbapi.com/apikey.aspx
# IMDb does NOT come from here: scripts/sync-ratings.ts reads IMDb's own daily
# dump, which is authoritative where OMDb keeps a copy that can lag.
OMDB_API_KEY=
